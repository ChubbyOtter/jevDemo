# Runtime grounding + assertion judgments (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=

# One-time "compile" pass that turns each NL step into a typed record (cached after first run)
ANTHROPIC_API_KEY=

# Only needed for a real iOS device (the Simulator needs no code signing at all).
# IOS_XCODE_ORG_ID: your Apple Developer Team ID (a free Xcode "Personal Team" works).
# IOS_WDA_BUNDLE_ID: the unique bundle id you gave the WebDriverAgentRunner target in
#   Xcode when you signed it (Facebook's default, com.facebook.WebDriverAgentRunner,
#   isn't yours to sign).
# IOS_XCODE_SIGNING_ID: usually fine left unset (defaults to "iPhone Developer").
IOS_XCODE_ORG_ID=
IOS_WDA_BUNDLE_ID=
IOS_XCODE_SIGNING_ID=
